        <path
            android:fillColor="#FFD97706"
            android:pathData="M0,0 L15.3,21.0 L10.5,3.4 Z" />
        <!-- Right bottom spoke lower -->
        <path
            android:fillColor="#FFB45309"
            android:pathData="M0,0 L15.3,21.0 L0,11 Z" />
        <!-- Left bottom spoke lower -->
        <path
            android:fillColor="#FFF59E0B"
            android:pathData="M0,0 L-15.3,21.0 L0,11 Z" />
        <!-- Left bottom spoke upper -->
        <path
            android:fillColor="#FFDFBB24"
            android:pathData="M0,0 L-15.3,21.0 L-10.5,3.4 Z" />
