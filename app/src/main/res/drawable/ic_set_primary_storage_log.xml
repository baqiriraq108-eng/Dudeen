        android:pathData="M88,62 H168 A12,12 0,0,1 180,74 V158 Q180,160 178.6,161.4 L147.4,192.6 Q146,194 144,194 H88 A12,12 0,0,1 76,182 V74 A12,12 0,0,1 88,62 Z" />

